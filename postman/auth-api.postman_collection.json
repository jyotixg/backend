{
  "info": {
    "name": "Auth API",
    "description": "Collection for the backend auth learning project. Endpoints are added as we build them (roadmap order).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Basic server-alive check (GET /)."
      },
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"charlie@example.com\",\n  \"password\": \"secret123\",\n  \"name\": \"Charlie\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register",
          "host": ["{{baseUrl}}"],
          "path": ["register"]
        },
        "description": "Create a new user. Expects JSON { email, password, name? }. Returns 201 with the user (no password), 400 if fields missing, 409 if email already exists."
      },
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"joy@example.com\",\n  \"password\": \"secret123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        },
        "description": "Log in. Expects JSON { email, password }. Returns 200 with user on success, 401 for wrong password or unknown email, 400 if fields missing."
      },
      "response": []
    },
    {
      "name": "Current user (/me)",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        },
        "description": "Protected route. Requires header 'Authorization: Bearer <token>'. Returns the logged-in user, or 401 if the token is missing/invalid/expired. Set the collection's {{token}} variable (or paste a token in the Authorization tab) after logging in."
      },
      "response": []
    },
    {
      "name": "Update profile (/me)",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Joy Updated\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        },
        "description": "Protected. Updates the logged-in user's own profile (name). Requires a valid Bearer token. Uses req.userId from the token, so a user can only edit their own record."
      },
      "response": []
    },
    {
      "name": "Admin: list users",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/admin/users",
          "host": ["{{baseUrl}}"],
          "path": ["admin", "users"]
        },
        "description": "Admin-only. Requires a valid Bearer token whose user has role 'admin'. Returns 200 + all users for admins, 403 for non-admins, 401 if no/invalid token. Note: role is baked into the token at login, so after changing a user's role you must log in again to get a token with the new role."
      },
      "response": []
    },
    {
      "name": "Refresh access token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"PASTE_REFRESH_TOKEN_HERE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["refresh"]
        },
        "description": "Exchange a valid refresh token for a new access token. Body: { refreshToken }. Returns 200 + { accessToken } if the refresh token is valid, 401 if missing/invalid/expired."
      },
      "response": []
    }
  ]
}
